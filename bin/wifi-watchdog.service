[Unit]
Description=Wi-Fi reconnect watchdog (NetworkManager no-secrets block)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /home/pi/wall_e-Mini/bin/wifi_watchdog.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
